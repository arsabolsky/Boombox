# Server
BOOMBOX_HOST=0.0.0.0
BOOMBOX_PORT=8443
DATABASE_URL=postgresql://boombox:changeme@localhost:5432/boombox
QUEUE_URL=redis://localhost:6379/0

# osquery enrollment
OSQUERY_ENROLL_SECRET=changeme

# Models (both keys required)
# decision model (Jev)
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# remediation model
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# seconds between client polls
POLL_INTERVAL=300
# where to send remediation scripts; blank = print them
REMEDIATION_API_URL=

# Notifications
DISCORD_WEBHOOK_URL=
