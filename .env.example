# Copy this file to .env and fill it in. Never commit .env.

# Decision model: TypeSafe Jev (required)
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Remediation model: OpenAI (required)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Seconds clients wait between polls
POLL_INTERVAL=300

# Where fix scripts are sent. Leave blank to print them in the server logs instead.
REMEDIATION_API_URL=
