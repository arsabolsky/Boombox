# Copy this file to .env and fill it in. Never commit .env.

# AI keys. Without them, everything works except POST /api/v1/results (it answers 503).
# Decision model: TypeSafe Jev
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Remediation model: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_REASONING_EFFORT=low      # minimal, low, medium or high

# Other addresses clients use to reach this server, comma separated (e.g. a LAN IP).
# Connections to these are the Boombox client itself and are never checked.
# The server's Docker address and all Tailscale addresses are already left out.
BOOMBOX_SERVER_ADDRESSES=

# Only needed when running an API outside Docker (docker compose sets this itself).
DATABASE_URL=postgresql://boombox:boombox@localhost:5432/boombox
