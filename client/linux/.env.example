API_HOST='http://127.0.0.1:8080' # Address or domain name of server
QUERIES_PATH='/api/v1/poll/queries'
QRESULTS_PATH='/api/v1/results' # Path for query results
RRESULTS_PATH='/api/v1/commands/results' # Path for command results
REMEDIATIONS_PATH='/api/v1/poll/remediations'
REGISTER_PATH='/api/v1/clients'
CLIENT_OS='linux' # Linux or Windows (it is always Linux)
OS_VERSION='Ubuntu 24.04.1 LTS' # Specific version (e.g. Ubuntu 24.04.1 LTS, Windows 10)
QUERY_INTERVAL=10 # How often to check for queries and remediations
