API_BASE_URL=http://localhost:8000/

# Leave blank until authentication is enabled.
API_TOKEN=

OSQUERY_PATH=C:\Program Files\osquery\osqueryi.exe
CLIENT_ID_PATH=C:\ProgramData\Boombox\client-id.txt

CHECK_WHOAMI=false
RUN_ONCE=false
ENABLE_REMEDIATION=true
REMEDIATION_API_PREFIX=remediations
REMEDIATION_POLL_INTERVAL_SECONDS=10
REMEDIATION_TIMEOUT_SECONDS=60
QUERY_TIMEOUT_SECONDS=30
HTTP_TIMEOUT_SECONDS=30
RESULTS_TIMEOUT_SECONDS=180
DEFAULT_POLL_INTERVAL_SECONDS=60
MINIMUM_POLL_INTERVAL_SECONDS=5
MAXIMUM_POLL_INTERVAL_SECONDS=3600
MAXIMUM_QUERY_OUTPUT_BYTES=5242880
